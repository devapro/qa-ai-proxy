+export default {
+    name: 'assistant-chat-status',
+    description:
+        'Makes sending an assistant chat message fail: POST /assistant/v1/chat is answered by the proxy with HTTP ' +
+        '`status` (default 500) and {"detail": "qa-proxy assistant-chat-status"}, without contacting the server. ' +
+        '402 opens the paywall, 5xx shows the inline "Couldn\'t send" error. Every other request stays real. ' +
+        'The app also needs a signed-in user with credits available, or it never sends the message.',
+    params: {
+        status: 500,
+    },
+    http: [
+        {
+            method: 'POST',
+            path: '/assistant/v1/chat',
+            onRequest(_, { params }) {
+                const status = Number(params.status);
+                if (!Number.isInteger(status) || status < 400 || status > 599) {
+                    throw new Error(`status must be an HTTP error code (400-599), got ${JSON.stringify(params.status)}`);
+                }
+                return { respond: { status, json: { detail: 'qa-proxy assistant-chat-status' } } };
+            },
+        },
+    ],
+};
